# REQUIRED: generate a long random secret and use the same value for lobby + room server.
ROOM_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Local development defaults. For an HTTPS public client use wss:// here.
PUBLIC_WS_URL=ws://127.0.0.1:9081
ALLOWED_ORIGIN=http://127.0.0.1:8080

# Capacity/rate values are deployment configuration and must be profiled/tuned on the VPS.
MAX_ACTIVE_ROOMS=16
CREATE_ROOM_LIMIT_PER_MINUTE=6
PASSWORD_ATTEMPTS_PER_MINUTE=5
