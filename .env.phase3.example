# Dokploy production values for https://ironveil.zvlz.dev.
PUBLIC_MODE=true
ROOM_TOKEN_SECRET=REPLACE_WITH_ONE_RANDOM_SECRET_AT_LEAST_32_CHARS
PUBLIC_WS_URL=wss://ironveil.zvlz.dev/room-ws
ALLOWED_ORIGIN=https://ironveil.zvlz.dev
TRUST_PROXY_HEADERS=true
MAX_ACTIVE_ROOMS=16
CREATE_ROOM_LIMIT_PER_MINUTE=6
PASSWORD_ATTEMPTS_PER_MINUTE=5
AUTH_ATTEMPTS_PER_MINUTE=10
GENERAL_REQUEST_LIMIT_PER_MINUTE=120
ROOM_TTL_SECONDS=21600
SESSION_TTL_SECONDS=2592000
MAX_WORLDS_PER_ACCOUNT=12
MAX_WORLD_CHECKPOINTS=5
WORLD_STORE_PATH=/data/persistence.json
WORLD_SNAPSHOT_PATH=/data/worlds
