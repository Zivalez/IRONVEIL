# Full-stack local defaults. For a public Dokploy deployment set PUBLIC_MODE=true.
PUBLIC_MODE=false
ROOM_TOKEN_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_WS_URL=ws://127.0.0.1:9081
ALLOWED_ORIGIN=http://127.0.0.1:8080
TRUST_PROXY_HEADERS=false
MAX_ACTIVE_ROOMS=16
CREATE_ROOM_LIMIT_PER_MINUTE=6
PASSWORD_ATTEMPTS_PER_MINUTE=5
AUTH_ATTEMPTS_PER_MINUTE=10
GENERAL_REQUEST_LIMIT_PER_MINUTE=120
ROOM_TTL_SECONDS=21600
SESSION_TTL_SECONDS=2592000
MAX_WORLDS_PER_ACCOUNT=12
MAX_WORLD_CHECKPOINTS=5
WORLD_STORE_PATH=/data/persistence.json
WORLD_SNAPSHOT_PATH=/data/worlds
